# ==============================================================================
# agy-lark configuration template
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` or real credentials to Git!
# ==============================================================================

# --- Feishu / Lark App Credentials (via official lark-oapi WebSocket) ---
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use https://open.feishu.cn for Feishu (China) or https://open.larksuite.com for Lark (Global)
FEISHU_DOMAIN=https://open.feishu.cn

# --- Security & Access Control (Fail-Closed by default) ---
# Comma-separated list of authorized user open_id values (e.g. ou_xxx,ou_yyy).
# IMPORTANT: Leaving this empty rejects ALL incoming messages for safety.
AGY_LARK_ALLOWED_OPEN_IDS=
# Set to true only if you want authorized users to trigger the bot via @mention in group chats.
AGY_LARK_ALLOW_GROUP_MENTION=false

# --- Antigravity (agy) ACP Runtime ---
# Leave empty to auto-detect `agy` from system PATH, or set an explicit executable path.
AGY_EXE=
# Default project workspace directory passed to agy sessions (defaults to current working directory).
AGY_DEFAULT_WORKSPACE=
# Maximum seconds allowed for a single agent turn before safety timeout.
AGY_TURN_TIMEOUT_SECONDS=600

# --- Streaming Cards & Daemon Logging ---
# Throttle interval (seconds) for CardKit 2.0 streaming updates.
AGY_LARK_STREAM_THROTTLE=0.25
AGY_LARK_DATA_DIR=.agy-lark
AGY_LARK_LOG_LEVEL=INFO
